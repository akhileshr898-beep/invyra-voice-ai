# ==============================================================================
# Invyra AI - Voice AI Personal Assistant & Medical Appointment Booking
# Environment Variables Template
# ==============================================================================

# 1. Google Gemini AI Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# 2. Deepgram Voice AI Configuration (STT Nova-2 & TTS Aura)
# Strictly replaces browser speech APIs for professional audio streaming.
# Sign up at https://console.deepgram.com/ to get your API key.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 3. Supabase Database Configuration (PostgreSQL)
# Obtain from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Google Calendar API Tool Integration
# Calendar ID ('primary' or specific calendar email)
GOOGLE_CALENDAR_ID=primary
# Google Cloud Console -> IAM & Admin -> Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Google Cloud Service Account Private Key (keep enclosed in quotes with escaped newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 5. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
